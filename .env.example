# Everything here has a working default; set what you need.

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# DATABASE_URL=postgres://user:pass@host:5432/dbname

# Vehicle and planning parameters.
VEHICLE_MPG=10
VEHICLE_RANGE_MI=500
# Dollars of driver time a stop is worth avoiding. 0 = cheapest fuel, any number of stops.
STOP_PENALTY_USD=10
CORRIDOR_MI=15
CORRIDOR_FALLBACK_MI=60

# Upstream map services. Point these at your own instances for heavy use --
# the public OSRM and Nominatim servers are demo-scale and rate limited.
# OSRM_URL=https://router.project-osrm.org
# NOMINATIM_URL=https://nominatim.openstreetmap.org/search
GEO_USER_AGENT=fuel-route-api/1.0 (your-email@example.com)

# Basemap for the map page. The default is Esri's keyless raster tiles --
# OpenStreetMap's own servers block apps they do not recognise, and Carto's
# free tiles now watermark without a key.
# MAP_TILE_URL=https://server.arcgisonline.com/ArcGIS/rest/services/World_Street_Map/MapServer/tile/{z}/{y}/{x}
